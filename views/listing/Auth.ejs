<%- layout("Layouts/boilerplate") %>

<div class="row Auth-padding">
     <div class="Auth-image-box col-md">
        <img src="/assets/front-page.jpg" alt="banner Loading" class="rounded Auth-villa" >
    </div>
    <div class="Auth col-md p-3">
       <div class="Auth-sign-up">
        <h2 class="mb-3 Sign-Up-color">Sign-up</h2>
       </div> 
      <form>
        <div class="mb-3">
            <label for="Email" class="form-label">Email:</label>
            <input type="email" class="form-control" id="Email">
        </div>
        <div class="mb-3">
            <label class="form-check-label" for="Username">Username</label>
            <input type="text" class="form-control" id="Username">
        </div>
        <div class="mb-3">
            <label for="Password" class="form-label">Password:</label>
            <input type="password" class="form-control" id="Password">
        </div>

        <div class="d-grid gap-2 col-6 mx-auto">
        <p>I have Alredy an Account<a href="#">Login</a></p>
        <button type="submit" class="btn btn-primary-LS">Sign-Up</button>
        </div>
      </form>
    </div>
</div>